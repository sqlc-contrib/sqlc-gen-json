{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/refs/heads/main/schemas/devContainer.base.schema.json",
  "name": "sqlc-gen-json",
  "image": "ghcr.io/nixos-contrib/nix-devcontainer:1",
  "workspaceFolder": "/workspaces/sqlc-gen-json",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/sqlc-gen-json,type=bind",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /nix /home/vscode/.cache"
}
